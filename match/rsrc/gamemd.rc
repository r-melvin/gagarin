// Reconstructed resource script: dialogs, the menu and the version information of gamemd.
// Icon and cursor groups are not here: see art_images.txt and scripts/vc6/rsrc_pack.py.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(1252)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDR_MENU_160 MENU
BEGIN
    POPUP "&Mode"
    BEGIN
        MENUITEM "640 x 400", 40309, CHECKED
        MENUITEM "640 x 480", 40304
        MENUITEM "800 x 600", 40305
        MENUITEM "1024 x 768", 40306
        MENUITEM "1280 x 1024", 40307
        MENUITEM SEPARATOR
    END
END

