# gagarin — matching-decompilation repo. Never commit EA bytes, the MS VC6
# toolchain, the retail binary, any PDB, or build output (AGENTS.md Legal Scope).

# --- Period MS VC6 toolchain (itsmattkc/MSVC600) + wine prefix ---
# MS-proprietary; fetched at build/CI time via scripts/vc6/fetch_toolchain.sh.
/toolchain

# --- Build output / match artifacts ---
/build/
build-vc6/
*.obj
*.o
*.exe
*.pdb
*.asm
# ...except the hand-written assembly translation units (AGENTS.md "Hand-written assembly").
!/match/asm/*.asm
*.cod

# Retail game asset archives (LEGAL.md).
*.[mM][iI][xX]

# --- reccmp per-user config (points at the user's own retail gamemd.exe) ---
reccmp-user.yml
reccmp-build.yml

# --- Consult-only external clones (referenced, not vendored) ---
reference/yrpp/
reference/phobos-docs/
# electronicarts/CnC_Red_Alert (GPLv3) — RA1 algorithm-shape reference
reference/ea_ra1/
# Vinifera-Developers/TSpp (GPLv3) — TS class map / original Westwood names
reference/tspp/
# The whole folder may be a symlink to private storage outside the repo; a
# trailing-slash pattern would not match the link itself.
/reference

# --- Ghidra-derived developer-only RE state (never ships publicly) ---
# All of state/ is developer-only RE seeds (by_addr bodies, addr/method maps,
# the gamemd.c/.h monolith, manifests) — kept local, never committed.
/state

# --- Python / IDE / OS noise ---
__pycache__/
*.pyc
.clangd
compile_commands.json
.cache/
.DS_Store

# --- Per-developer agent tooling state, not part of the project ---
.claude/
.serena/
.remember/
memory/
agents/
logs/

# --- Working notes and RE artefacts: NOT for the public repository ---
# docs/ is a private working-notes location, outside the public build and
# verification inputs. Do not use or publish its contents. The authoritative
# match manifest is tracked at scripts/data/match_manifest.json.
/docs

# --- Data derived from the private reference reimplementation ---
# Address-to-behaviour corpora mined from a private project's history. The facts
# they point at are confirmed against the binary before use, but the corpora
# themselves carry that project's names and paths and are not ours to publish.
scripts/data/reference_*.json

# Temporary decomp-permuter debug source (never a maintained reconstruction).
/debug_source.c

# Shared local agent coordination and isolated worktrees (never published).
/.coordination/
/.worktrees/
